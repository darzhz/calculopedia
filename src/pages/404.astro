---
import BaseLayout from '@/components/layout/BaseLayout.astro';
import AmbientShapes from '@/components/layout/AmbientShapes.astro';
---

<BaseLayout title="Page not found" canonicalPath="/404/" noindex>
  <section class="relative mx-auto max-w-lg py-16 text-center">
    <AmbientShapes variant="hero" />
    <div class="relative">
      <p class="text-6xl font-medium text-md-primary">404</p>
      <h1 class="mt-5 text-2xl font-medium text-md-on-surface">Page not found</h1>
      <p class="mt-3 leading-relaxed text-md-on-surface-variant">
        The page you're looking for doesn't exist. Try searching for a calculator.
      </p>
      <a href="/calculators/" class="btn btn-lg btn-filled mt-8">
        <span class="icon text-[20px]">apps</span>
        Browse all calculators
      </a>
    </div>
  </section>
</BaseLayout>
