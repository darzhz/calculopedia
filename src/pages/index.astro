---
import BaseLayout from '@/components/layout/BaseLayout.astro';
import AdSlot from '@/components/layout/AdSlot.astro';
import AmbientShapes from '@/components/layout/AmbientShapes.astro';
import { CATEGORIES, TOP_CALCULATORS, SITE_NAME, categoryBySlug } from '@/lib/site';
import { loadEntries, pageUrl, findBySlug } from '@/lib/registry';
import { breadcrumbSchema } from '@/lib/seo';

const entries = loadEntries();
const top = TOP_CALCULATORS.map((s) => findBySlug(s)).filter((e) => e !== undefined);
const features = [
  {
    icon: 'bolt',
    title: 'Instant answers',
    text: 'Every tool computes in your browser — results appear as you type.',
  },
  {
    icon: 'lock',
    title: 'Private & free',
    text: 'All calculators are free forever. No sign-up, no account, no data leaves your device.',
  },
  {
    icon: 'menu_book',
    title: 'Explained simply',
    text: 'Each calculator shows the formula and a worked example so you understand the result.',
  },
];
---

<BaseLayout title={SITE_NAME} canonicalPath="/">
  <Fragment slot="schema">
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(breadcrumbSchema([{ name: 'Home', url: '/' }]))}
    />
  </Fragment>

  <section class="relative overflow-hidden p-6">
    <AmbientShapes variant="hero" />
    <div
      class="relative rounded-[32px] bg-md-surface-container px-5 py-12 text-center sm:px-8 md:rounded-[48px] md:py-20"
    >
      <span
        class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-[20px] bg-md-primary-container text-md-on-primary-container shadow-sm"
      >
        <span class="icon text-[34px]">calculate</span>
      </span>
      <h1
        class="mx-auto max-w-2xl text-3xl font-medium tracking-tight text-md-on-surface sm:text-4xl md:text-5xl"
      >
        Free calculators for every need
      </h1>
      <p
        class="mx-auto mt-5 max-w-2xl text-base leading-relaxed text-md-on-surface-variant sm:text-lg"
      >
        {entries.length} fast, free, client-side calculators for finance, health, dates and math — with
        plain-English answers and worked examples.
      </p>
      <p class="mt-3 text-sm text-md-on-surface-variant/70">
        No sign-up. No page reloads. Works on any device.
      </p>
      <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
        <a href="/calculators/" class="btn btn-lg btn-filled">
          Browse all calculators
          <span class="icon text-[20px]">arrow_forward</span>
        </a>
        <a href="/blog/" class="btn btn-lg btn-tonal">
          <span class="icon text-[20px]">article</span>
          Read the blog
        </a>
      </div>
    </div>
  </section>

  <section class="mt-12 md:mt-16">
    <div class="flex items-baseline justify-between">
      <h2 class="text-xl font-medium tracking-tight text-md-on-surface sm:text-2xl">
        Browse by category
      </h2>
      <a
        href="/calculators/"
        class="hidden text-sm font-medium text-md-primary hover:text-md-primary/80 sm:block"
      >
        All calculators
      </a>
    </div>
    <div class="mt-6 mb-6 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        CATEGORIES.map((cat) => (
          <a href={`/${cat.slug}/`} class="card card-hover group p-6">
            <span class="flex h-11 w-11 items-center justify-center rounded-2xl bg-md-primary-container text-md-on-primary-container transition-transform duration-300 ease-md group-hover:scale-110">
              <span class="icon text-[24px]">{cat.icon}</span>
            </span>
            <span class="mt-5 block text-base font-medium text-md-on-surface">{cat.label}</span>
            <span class="mt-1.5 block text-sm text-md-on-surface-variant">{cat.tagline}</span>
          </a>
        ))
      }
    </div>
  </section>

  <AdSlot id="home-leaderboard" unit="leaderboard" />

  <section class="mt-12 md:mt-16">
    <div class="flex items-baseline justify-between">
      <h2 class="text-xl font-medium tracking-tight text-md-on-surface sm:text-2xl">
        Most popular
      </h2>
      <a href="/calculators/" class="text-sm font-medium text-md-primary hover:text-md-primary/80">
        All calculators
        <span class="icon align-middle text-[18px]">chevron_right</span>
      </a>
    </div>
    <div class="mt-6 mb-6 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        top.map((entry) => (
          <a href={pageUrl(entry!)} class="card card-hover group p-6">
            <span class="flex h-11 w-11 items-center justify-center rounded-full bg-md-secondary-container text-md-on-secondary-container transition-transform duration-300 ease-md group-hover:scale-110">
              <span class="icon text-[24px]">
                {entry!.config.icon ?? categoryBySlug(entry!.config.category)?.icon ?? 'calculate'}
              </span>
            </span>
            <span class="mt-5 block font-medium text-md-on-surface">{entry!.config.title}</span>
            <span class="mt-1.5 block text-sm text-md-on-surface-variant">
              {entry!.config.shortDescription}
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <section
    class="relative mt-12 overflow-hidden rounded-[32px] bg-md-surface-container p-6 sm:p-8 md:mt-16 md:rounded-[48px] md:p-10"
  >
    <AmbientShapes variant="section" />
    <div class="relative">
      <h2 class="text-xl font-medium tracking-tight text-md-on-surface sm:text-2xl">
        Why {SITE_NAME}?
      </h2>
      <div class="mt-8 grid gap-8 sm:grid-cols-3">
        {
          features.map((f) => (
            <div class="flex flex-col gap-4">
              <span class="flex h-11 w-11 items-center justify-center rounded-full bg-md-tertiary-container text-md-on-tertiary-container">
                <span class="icon text-[24px]">{f.icon}</span>
              </span>
              <div>
                <h3 class="font-medium text-md-on-surface">{f.title}</h3>
                <p class="mt-1.5 text-sm leading-relaxed text-md-on-surface-variant">{f.text}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>
