---
import { getCollection } from 'astro:content';
import BaseLayout from '@/components/layout/BaseLayout.astro';
import Breadcrumbs from '@/components/layout/Breadcrumbs.astro';
import AdSlot from '@/components/layout/AdSlot.astro';
import { breadcrumbSchema, articleSchema } from '@/lib/seo';
import { renderMarkdown, splitMarkdown } from '@/lib/markdown';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({ params: { slug: post.id } }));
}

const { slug } = Astro.params;
const entry = (await getCollection('blog')).find((p) => p.id === slug);
if (!entry) return Astro.redirect('/blog/');

const { first, second } = splitMarkdown(entry.body ?? '', 1000);
const path = `/blog/${entry.id}/`;
const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'Blog', url: '/blog/' },
  { name: entry.data.title, url: path },
];
---

<BaseLayout
  title={entry.data.title}
  description={entry.data.description}
  canonicalPath={path}
  ogType="article"
>
  <Fragment slot="schema">
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(breadcrumbSchema(breadcrumbs))}
    />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(
        articleSchema(
          entry.data.title,
          entry.data.description,
          path,
          entry.data.datePublished,
          entry.data.updated ?? entry.data.datePublished,
        ),
      )}
    />
  </Fragment>

  <Breadcrumbs items={breadcrumbs} />

  <article class="mx-auto max-w-3xl space-y-8">
    <header>
      <h1 class="text-2xl font-medium tracking-tight text-md-on-surface sm:text-3xl md:text-4xl">
        {entry.data.title}
      </h1>
      <p class="mt-3 inline-flex items-center gap-1.5 text-sm text-md-on-surface-variant">
        <span class="icon text-[18px]">calendar_month</span>
        Published {entry.data.datePublished}
        {entry.data.updated ? ` · Updated ${entry.data.updated}` : ''}
      </p>
    </header>
    <div class="prose-calc">
      <Fragment set:html={renderMarkdown(first)} />
      {second && (
        <div class="my-8">
          <AdSlot id={`blog-${entry.id}-in-article`} unit="inArticle" />
        </div>
      )}
      {second && <Fragment set:html={renderMarkdown(second)} />}
    </div>
  </article>
</BaseLayout>
