---
import BaseLayout from '@/components/layout/BaseLayout.astro';
import { SITE_NAME } from '@/lib/site';
---

<BaseLayout
  title="Contact"
  canonicalPath="/contact/"
  description={`Get in touch with the ${SITE_NAME} team.`}
>
  <section class="mx-auto max-w-3xl">
    <h1 class="text-2xl font-medium tracking-tight text-md-on-surface sm:text-3xl">
      Contact
    </h1>
    <p class="mt-3 text-sm leading-relaxed text-md-on-surface-variant">
      Questions, feedback or suggestions about a calculator? We'd love to hear from you.
    </p>

    <div class="mt-8 space-y-8">
      <section>
        <h2 class="text-xl font-medium tracking-tight text-md-on-surface">Email</h2>
        <p class="mt-3 text-sm leading-relaxed text-md-on-surface-variant">
          The fastest way to reach us is by email:
        </p>
        <p class="mt-3">
          <a
            href="mailto:hi@darzh.xyz"
            class="text-sm font-medium text-md-primary underline underline-offset-4 hover:text-md-primary-container"
          >
            hi@darzh.xyz
          </a>
        </p>
      </section>

      <section>
        <h2 class="text-xl font-medium tracking-tight text-md-on-surface">Address</h2>
        <p class="mt-3 text-sm leading-relaxed text-md-on-surface-variant">
          You can also write to us at:
        </p>
        <address class="mt-3 text-sm leading-relaxed text-md-on-surface-variant">
          Darzh<br />
          Kollam, Kerala<br />
          India
        </address>
      </section>
    </div>
  </section>
</BaseLayout>
