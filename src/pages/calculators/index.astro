---
import BaseLayout from '@/components/layout/BaseLayout.astro';
import Breadcrumbs from '@/components/layout/Breadcrumbs.astro';
import AmbientShapes from '@/components/layout/AmbientShapes.astro';
import { CATEGORIES } from '@/lib/site';
import { loadEntries, pageUrl } from '@/lib/registry';
import { breadcrumbSchema } from '@/lib/seo';

const entries = loadEntries();
const total = entries.length;
const breadcrumbs = [
  { name: 'Home', url: '/' },
  { name: 'All calculators', url: '/calculators/' },
];
---

<BaseLayout
  title="All Calculators — Full Directory"
  description={`Browse all ${total} free online calculators, organized by category.`}
  canonicalPath="/calculators/"
>
  <Fragment slot="schema">
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(breadcrumbSchema(breadcrumbs))}
    />
  </Fragment>

  <Breadcrumbs items={breadcrumbs} />

  <section class="relative overflow-hidden">
    <AmbientShapes variant="hero" />
    <div class="relative">
      <h1 class="text-2xl font-medium tracking-tight text-md-on-surface sm:text-3xl md:text-4xl">
        All calculators
      </h1>
      <p class="mt-3 text-md-on-surface-variant">
        {total} free tools — pick a category or scroll to browse.
      </p>
      <nav class="mt-6 flex flex-wrap gap-2" aria-label="Category filter">
        {
          CATEGORIES.map((cat) => (
            <a href={`#${cat.slug}`} class="chip">
              <span class="icon text-[18px]">{cat.icon}</span>
              {cat.label}
            </a>
          ))
        }
      </nav>
    </div>
  </section>

  <div class="mt-10 space-y-14 md:mt-12 md:space-y-16">
    {
      CATEGORIES.map((cat) => {
        const catEntries = entries.filter((e) => e.config.category === cat.slug);
        if (!catEntries.length) return null;
        return (
          <section id={cat.slug}>
            <h2 class="flex items-center gap-2 text-xl font-medium tracking-tight text-md-on-surface sm:text-2xl">
              <span class="icon text-[26px] text-md-primary">{cat.icon}</span>
              {cat.label}
            </h2>
            <p class="mt-2 text-sm text-md-on-surface-variant">{cat.description}</p>
            <div class="mt-6 grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
              {catEntries.map((entry) => (
                <a href={pageUrl(entry)} class="card card-hover group p-6">
                  <span class="flex h-10 w-10 items-center justify-center rounded-full bg-md-secondary-container text-md-on-secondary-container transition-transform duration-300 ease-md group-hover:scale-110">
                    <span class="icon text-[22px]">{entry.config.icon ?? cat.icon}</span>
                  </span>
                  <span class="mt-4 block font-medium text-md-on-surface">
                    {entry.config.title}
                  </span>
                  <span class="mt-1.5 block text-sm text-md-on-surface-variant">
                    {entry.config.shortDescription}
                  </span>
                </a>
              ))}
            </div>
          </section>
        );
      })
    }
  </div>
</BaseLayout>
